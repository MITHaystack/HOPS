# Resolve the prefix relative to this .pc file's own location so the file is relocatable
# using (${pcfiledir} requires pkg-config >= 0.29
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: @PC_NAME@
Description: @PC_DESCRIPTION@
Version: @HOPS_VERSION_NUMBER@
Requires: @PC_REQUIRES@
Requires.private: @PC_REQUIRES_PRIVATE@
Libs: -L${libdir} @PC_LIBS@
Libs.private: @PC_LIBS_PRIVATE@
Cflags: -I${includedir} @PC_CFLAGS@
